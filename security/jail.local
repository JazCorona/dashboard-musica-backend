[DEFAULT]
# Banea TODOS los puertos de la IP ofensora (no solo HTTP).
banaction = iptables-allports
ignoreip  = 127.0.0.1/8
usedns    = no
# Polling: compatible con un archivo de log normal, sin journald.
backend   = polling

# Escalado de bans para reincidentes, con techo de 1 día.
bantime            = 10m
bantime.increment  = true
bantime.factor     = 2
bantime.maxtime    = 1d
bantime.rndtime    = 30s

# Esta imagen no es un servidor SSH: desactiva los jails por defecto de la
# distribución para que Fail2Ban no falle buscando /var/log/auth.log.
[sshd]
enabled = false
[sshd-ddos]
enabled = false

[http-flood]
enabled  = true
port     = http,https
filter   = http-flood
logpath  = /var/log/nginx/access.log
# Banea tras 60 peticiones en cualquier ventana de 10s (~6 req/s sostenidas).
# Tolera ráfagas cortas pero reacciona rápido al flood del script de carga.
# >>> Ajusta maxretry/findtime para tus pruebas de carga <<<
maxretry = 60
findtime = 10s
